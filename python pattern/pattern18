import turtle
t=turtle.Turtle()
t.speed(-4)
t.left(90)
t.penup()
t.goto(-100,0)
t.pensize(2)
t.pendown()
t.color("blue", "green")
for i in range(300):
    t.forward(i)
    t.circle(44,30)
    t.right(40)
t.end_fill()
t.forward(100)
t.color("red")
t.forward(100)
t.color("yellow")
t.forward(100)
t.right(90)